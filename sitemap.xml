---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.pages %}
    {% unless page.url contains "404" or page.url contains ".xml" or page.url contains "robots.txt" or page.url contains "index-dev" %}
    <url>
      <loc>{{ site.url }}{{ page.url | remove: "index.html" }}</loc>
      <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
      <changefreq>{% if page.url == "/" %}weekly{% else %}monthly{% endif %}</changefreq>
      <priority>{% if page.url == "/" %}1.0{% else %}0.7{% endif %}</priority>
    </url>
    {% endunless %}
  {% endfor %}
  {% for event in site.events %}
    <url>
      <loc>{{ site.url }}{{ event.url }}</loc>
      <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
      <changefreq>weekly</changefreq>
      <priority>0.8</priority>
    </url>
  {% endfor %}
</urlset>
